# Development Environment Variables
# Copy this file to .env for local development

# Pre-commit cache location (for local development only)
# This prevents permission issues and speeds up pre-commit hooks
PRE_COMMIT_HOME=./.pre-commit-cache

# Optional: Debug mode for more verbose logging
# BGBR_DEBUG=1

# Optional: Disable YASA for faster testing
# BGBR_DISABLE_YASA=1
