[importlinter]
root_package = brain_go_brrr

# Prevent API from being imported by lower layers
[importlinter:contract:api_top_layer]
name = API is the top layer
type = forbidden
source_modules =
    brain_go_brrr.domain
    brain_go_brrr.application
    brain_go_brrr.infra
    brain_go_brrr.core
    brain_go_brrr.services
forbidden_modules =
    brain_go_brrr.api

# Prevent presentation from being imported by non-API layers
[importlinter:contract:presentation_layer]
name = Presentation layer dependencies
type = forbidden
source_modules =
    brain_go_brrr.domain
    brain_go_brrr.application
    brain_go_brrr.infra
    brain_go_brrr.core
    brain_go_brrr.services
forbidden_modules =
    brain_go_brrr.presentation

# Core compatibility layer should not import from new architecture
[importlinter:contract:core_compatibility]
name = Core is a compatibility shim only
type = forbidden
source_modules =
    brain_go_brrr.core
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Services compatibility layer constraints
[importlinter:contract:services_compatibility]
name = Services is a compatibility shim
type = forbidden
source_modules =
    brain_go_brrr.services
forbidden_modules =
    brain_go_brrr.api

# Models/preprocessing/visualization/config are deprecated redirects
[importlinter:contract:deprecated_redirects]
name = Deprecated modules are redirects only
type = forbidden
source_modules =
    brain_go_brrr.models
    brain_go_brrr.preprocessing
    brain_go_brrr.visualization
    brain_go_brrr.config
forbidden_modules =
    brain_go_brrr.api