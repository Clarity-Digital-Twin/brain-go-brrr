[importlinter]
root_package = brain_go_brrr

# Contract 1: Domain layer must be pure (no dependencies on outer layers)
[importlinter:contract:domain_pure]
name = Domain layer is pure
type = forbidden
source_modules =
    brain_go_brrr.domain
forbidden_modules =
    brain_go_brrr.application
    brain_go_brrr.infra
    brain_go_brrr.api
    brain_go_brrr.presentation
ignore_imports =
    # Allow legacy imports in non-clean modules for backward compatibility
    brain_go_brrr.domain.abnormal.detector -> brain_go_brrr.application.config
    brain_go_brrr.domain.abnormal.detector -> brain_go_brrr.infra.logger
    brain_go_brrr.domain.abnormal.detector -> brain_go_brrr.infra.ml_models.eegpt_model
    brain_go_brrr.domain.abnormal.detector -> brain_go_brrr.infra.preprocessing.eeg_preprocessor
    brain_go_brrr.domain.quality.controller -> brain_go_brrr.infra.ml_models.eegpt_model
    brain_go_brrr.domain.preprocessing.features.extractor -> brain_go_brrr.infra.ml_models.eegpt_model
    brain_go_brrr.domain.preprocessing.features.extractor -> brain_go_brrr.infra.preprocessing.flexible_preprocessor

# Contract 2: Application layer can only depend on domain
[importlinter:contract:application_dependencies]
name = Application layer depends only on domain
type = forbidden
source_modules =
    brain_go_brrr.application
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 3: API/Presentation are top layers
[importlinter:contract:api_top]
name = API/presentation are top layers
type = forbidden
source_modules =
    brain_go_brrr.domain
    brain_go_brrr.application
    brain_go_brrr.infra
    brain_go_brrr.core
    brain_go_brrr.services
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 4: Infrastructure can depend on domain but not API
[importlinter:contract:infra_dependencies]
name = Infrastructure depends correctly
type = forbidden
source_modules =
    brain_go_brrr.infra
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 5: Services layer can use domain and infra
[importlinter:contract:services_dependencies]
name = Services layer dependencies
type = forbidden
source_modules =
    brain_go_brrr.services
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 6: Core utilities are independent
[importlinter:contract:core_independent]
name = Core is independent
type = forbidden
source_modules =
    brain_go_brrr.core
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 7: Models/preprocessing/visualization/config are deprecated redirects
[importlinter:contract:deprecated_redirects]
name = Deprecated modules are redirects only
type = forbidden
source_modules =
    brain_go_brrr.models
    brain_go_brrr.preprocessing
    brain_go_brrr.visualization
    brain_go_brrr.config
forbidden_modules =
    brain_go_brrr.api