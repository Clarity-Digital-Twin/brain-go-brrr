[importlinter]
root_package = brain_go_brrr

# ===================================================================
# UNCLE BOB'S CLEAN ARCHITECTURE - 100% STRICT ENFORCEMENT
# ===================================================================

# Contract 1: DOMAIN MUST BE PURE - NO EXCEPTIONS
[importlinter:contract:domain_pure]
name = Domain must be PURE (no dependencies on outer layers)
type = forbidden
source_modules =
    brain_go_brrr.domain
forbidden_modules =
    brain_go_brrr.application
    brain_go_brrr.infra
    brain_go_brrr.api
    brain_go_brrr.presentation
    brain_go_brrr.services
    brain_go_brrr.models
    brain_go_brrr.preprocessing
    brain_go_brrr.visualization
    brain_go_brrr.config
# Domain CAN import from core (utilities are leaf nodes)

# Contract 2: CLEAN ARCHITECTURE LAYERS
[importlinter:contract:layers]
name = Clean Architecture Layers (outer -> inner only)
type = layers
layers =
    brain_go_brrr.api
    brain_go_brrr.presentation
    brain_go_brrr.application
    brain_go_brrr.domain

# Contract 3: APPLICATION LAYER RULES
[importlinter:contract:application_clean]
name = Application layer can only orchestrate
type = forbidden
source_modules =
    brain_go_brrr.application
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 4: INFRASTRUCTURE INDEPENDENCE
[importlinter:contract:infra_no_api]
name = Infrastructure cannot depend on API/Presentation
type = forbidden
source_modules =
    brain_go_brrr.infra
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 5: INFRA NO APPLICATION
[importlinter:contract:infra_no_app]
name = Infrastructure cannot depend on Application
type = forbidden
source_modules =
    brain_go_brrr.infra
forbidden_modules =
    brain_go_brrr.application

# Contract 6: SERVICES LAYER RULES
[importlinter:contract:services_clean]
name = Services cannot depend on API/Presentation
type = forbidden
source_modules =
    brain_go_brrr.services
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 7: CORE UTILITIES INDEPENDENCE
[importlinter:contract:core_independent]
name = Core utilities must be independent (leaf nodes)
type = forbidden
source_modules =
    brain_go_brrr.core
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation
    brain_go_brrr.application
    brain_go_brrr.domain
    brain_go_brrr.infra
    brain_go_brrr.services

# Contract 8: DEPRECATED MODULES
[importlinter:contract:deprecated_redirects]
name = Deprecated modules are redirects only
type = forbidden
source_modules =
    brain_go_brrr.models
    brain_go_brrr.preprocessing
    brain_go_brrr.visualization
    brain_go_brrr.config
forbidden_modules =
    brain_go_brrr.api
    brain_go_brrr.presentation

# Contract 9: DOMAIN PORTS ARE PURE
[importlinter:contract:ports_pure]
name = Domain ports cannot have implementation dependencies
type = forbidden
source_modules =
    brain_go_brrr.domain.abnormal.ports
    brain_go_brrr.domain.ports
forbidden_modules =
    brain_go_brrr.infra
    brain_go_brrr.application
    brain_go_brrr.api
